<% layout("/layouts/boilerplate") %>

<div class="row">
    <div class="col-8 offset-2">
         <br>
    <h2>Create New Listing</h2>

    <form method="POST" action="/listings">

        <!-- Title -->
        <br>
        <div class="mb-3">
            <label for="title" class="form-label">Enter Title</label>
            <input
                name="listing[title]"
                placeholder="Enter Title"
                type="text"
                class="form-control"
                id="title"
            >
        </div>

        <!-- Description -->
        <div class="mb-3">
            <label for="description" class="form-label">Enter Description</label>
            <textarea
                name="listing[description]"
                placeholder="Enter Description"
                class="form-control"
                id="description"
            ></textarea>
        </div>

        <!-- Image -->
        <div class="mb-3">
            <label for="image" class="form-label">Enter Image URL/Link</label>
            <input
                name="listing[image]"
                placeholder="Enter Image URL/Link"
                type="text"
                class="form-control"
                id="image"
            >
        </div>

        <div class="row">
            <!-- Price -->
            <div class="mb-3 col-md-4">
                <label for="price" class="form-label">Enter Price</label>
                <input
                    name="listing[price]"
                    placeholder="Enter Price"
                    type="number"
                    class="form-control"
                    id="price"
                >
            </div>

            <!-- Country -->
            <div class="mb-3 col-md-8">
                <label for="country" class="form-label">Enter Country</label>
                <input
                    name="listing[country]"
                    placeholder="Enter Country"
                    type="text"
                    class="form-control"
                    id="country"
                >
            </div>

        </div>
        
        <!-- Location -->
        <div class="mb-3">
            <label for="location" class="form-label">Enter Location</label>
            <input
                name="listing[location]"
                placeholder="Enter Location"
                type="text"
                class="form-control"
                id="location"
            >
        </div>

        <button class="btn btn-danger add-btn">Add</button>
        <br><br>
    </form>
    </div>
</div>