<% layout("/layouts/boilerplate") %>
<div class="row mt-2">
    <div class="col-10 offset-2">
<br><br>
    <h2>Edit Listing</h2>

    <form method="POST" action="/listings/<%= listing._id %>?_method=PUT">

        <!-- Title -->
        <div class="mb-3">
            <label for="title" class="form-label">Enter Title</label>
            <input
                name="listing[title]"
                value="<%= listing.title %>"
                placeholder="Enter Title"
                type="text"
                class="form-control"
                id="title"
            >
        </div>

        <!-- Description -->
        <div class="mb-3">
            <label for="description" class="form-label">Enter Description</label>
            <textarea
                name="listing[description]"
                placeholder="Enter Description"
                class="form-control"
                id="description"
            ><%= listing.description %></textarea>
        </div>

        <!-- Image -->
        <div class="mb-3">
            <label for="image" class="form-label">Enter Image URL</label>
            <input
                name="listing[image]"
                value="<%= listing.image.url %>"
                placeholder="Enter Image URL"
                type="text"
                class="form-control"
                id="image"
            >
        </div>
        <div class="row">
        <!-- Price -->
                <div class="mb-3 col-md-4">
                    <label for="price" class="form-label">Enter Price</label>
                    <input
                        name="listing[price]"
                        value="<%= listing.price %>"
                        placeholder="Enter Price"
                        type="number"
                        class="form-control"
                        id="price"
                    >
                </div>
                    <!-- Country -->
                    <div class="mb-3 col-md-8">
                        <label for="country" class="form-label">Enter Country Name</label>
                        <input
                            name="listing[country]"
                            value="<%= listing.country %>"
                            placeholder="Enter Country Name"
                            type="text"
                            class="form-control"
                            id="country"
                        >
                    </div>

            </div>

            <!-- Location -->
            <div class="mb-3">
                <label for="location" class="form-label">Enter Location</label>
                <input
                    name="listing[location]"
                    value="<%= listing.location %>"
                    placeholder="Enter Location"
                    type="text"
                    class="form-control"
                    id="location"
                >
            </div>

        <br>

        <button class="btn btn-danger mt-3 edit-btn">Edit</button>

    </form>
    </div>
</div>